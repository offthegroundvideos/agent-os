OLLAMA_URL=http://localhost:11434
DEFAULT_MODEL=gemma4:latest
RESEARCH_MODEL=gemma4:latest

# API protection
AGENT_OS_API_SECRET=
AGENT_OS_ALLOW_UNPROTECTED_WEBHOOKS=false

# Transactional persistence and durable background execution
# Defaults to data/durable.sqlite when omitted.
AGENT_OS_DURABLE_DB_FILE=
VIRAL_RESEARCH_DB_FILE=
# Running jobs with no heartbeat for this many minutes are reclaimed (default 5).
BACKGROUND_JOB_STALE_MINUTES=5

# Branded viral-intelligence PDF generation
PYTHON_PATH=python
VIRAL_REPORT_SCRIPT=scripts/generate_viral_intelligence_pdf.py

# Research discovery providers
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
CLOUDFLARE_INGEST_SECRET=
PROSPECT_RADAR_DISCOVERY_URL=

# Instagram/TikTok public-metrics enrichment (all optional; layered cheapest-first)
# 1. Direct page fetch always runs (free, no key).
# 2. Cloudflare edge fetch: deploy cloudflare/social-metrics-worker.js, then set:
SOCIAL_SCRAPE_WORKER_URL=
SOCIAL_SCRAPE_WORKER_SECRET=
# 3. Firecrawl scrape fallback reuses FIRECRAWL_API_KEY above.
# 4. Specialized social APIs (best data quality, paid):
SCRAPECREATORS_API_KEY=
# Max paid ScrapeCreators calls per day (1 call = 1 credit). Default 20; 0 = unlimited.
SCRAPECREATORS_DAILY_CREDIT_CAP=20
ENSEMBLEDATA_TOKEN=

# Public media hosting for publish adapters
PUBLIC_MEDIA_BASE_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:4000
RENDER_MEDIA_SEED_FILE=

# Instagram live publishing
PUBLISH_INSTAGRAM_MODE=simulate
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
# The same authorized account is used for owned-media performance snapshots.
INSTAGRAM_GRAPH_API_VERSION=v23.0

# YouTube live publishing
PUBLISH_YOUTUBE_MODE=simulate
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CHANNEL_ID=
# The same authorized channel is used for owned-video performance snapshots.

# Website booking research intake
BOOKING_WEBHOOK_SECRET=

# OTG-OS core
OTG_OS_DB_FILE=
OTG_OS_BACKUP_DIR=
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
HEALTHCHECKS_PING_URL=
OTG_BUSINESS_MAILING_ADDRESS=
# OTG-OS extra model providers (optional)
DEEPSEEK_API_KEY=
XAI_API_KEY=
