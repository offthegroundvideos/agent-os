{
  "name": "agent-os",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "next dev -H 0.0.0.0 -p 4000",
    "build": "next build",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-agent-os.ps1",
    "start:no-build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-agent-os.ps1 -SkipBuild",
    "start:raw": "next start -H 0.0.0.0 -p 4000",
    "sync-context": "node scripts/update-claude-md.js",
    "os:worker": "node scripts/otg-os-worker.mjs",
    "os:demo": "node scripts/otg-os-demo-approval.mjs",
    "os:mcp": "node --no-warnings scripts/otg-os-mcp.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "next": "^16.2.7",
    "playwright-core": "^1.58.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "autoprefixer": "^10.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.3.0"
  },
  "overrides": {
    "postcss": "^8.5.15"
  }
}
